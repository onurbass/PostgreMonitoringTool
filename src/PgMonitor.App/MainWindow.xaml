<Window x:Class="PgMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PgMonitor.App.ViewModels"
        Title="PgMonitor – PostgreSQL Lock İzleme" Width="1280" Height="860" MinWidth="900" MinHeight="600"
        Background="{StaticResource Panel}" FontFamily="Segoe UI" FontSize="12"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="HideWhenEmpty" TargetType="TextBlock">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SqlBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Background" Value="#FBFCFD"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Simulated-data banner: always visible in demo mode -->
        <Border DockPanel.Dock="Top" Background="#DD6B20" Padding="12,6"
                Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}">
            <TextBlock Foreground="White" FontWeight="Bold" FontSize="13"
                       Text="SİMÜLASYON VERİSİ – bu ekrandaki her şey kurgusal; gerçek veritabanına bağlı değil. Canlı izleme için Ayarlar → Canlı."/>
        </Border>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Veri klasörü" Command="{Binding OpenDataFolderCommand}"/>
                    <Button Content="Mail dosyaları" Command="{Binding OpenMailFolderCommand}" Margin="0"
                            Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource Muted}" Text="{Binding ModeText}"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="8" Background="{StaticResource Panel}">
            <!-- ============================================================ DASHBOARD -->
            <TabItem Header="  Pano  " DataContext="{Binding Dashboard}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="1.6*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border x:Name="StatusBar" Grid.Row="0" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Accent}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Ok"><Setter Property="Background" Value="{StaticResource Ok}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Warn"><Setter Property="Background" Value="{StaticResource Warn}"/></DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="Bad"><Setter Property="Background" Value="{StaticResource Bad}"/></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusDetail}" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <WrapPanel Grid.Row="1">
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="SON ÖRNEK"/><TextBlock Style="{StaticResource Value}" Text="{Binding LastSample}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="SESSION"/><TextBlock Style="{StaticResource Value}" Text="{Binding Sessions}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="LOCK BEKLEYEN"/><TextBlock Style="{StaticResource Value}" Text="{Binding LockWaiters}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="EŞİĞİ AŞAN"/><TextBlock Style="{StaticResource Value}" Text="{Binding OverThreshold}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="EN UZUN BEKLEME"/><TextBlock Style="{StaticResource Value}" Text="{Binding LongestWait}"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Style="{StaticResource Label}" Text="GÖRÜNÜRLÜK"/><TextBlock Style="{StaticResource Value}" Text="{Binding Visibility}"/></StackPanel></Border>
                    </WrapPanel>

                    <TextBlock Grid.Row="2" Text="{Binding Warnings}" Foreground="{StaticResource Bad}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource HideWhenEmpty}"/>

                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Kök bloklayıcılar (şüpheli – zincirin başı, kesin neden değil)"/>
                        <TextBox DockPanel.Dock="Bottom" Height="44" Style="{StaticResource SqlBox}" Text="{Binding SelectedBlocker.FullSql, Mode=OneWay}"/>
                        <DataGrid ItemsSource="{Binding Blockers}" SelectedItem="{Binding SelectedBlocker}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}"/>
                                <DataGridTextColumn Header="Veritabanı" Binding="{Binding Database}"/>
                                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}"/>
                                <DataGridTextColumn Header="İstemci" Binding="{Binding Client}"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding State}"/>
                                <DataGridTextColumn Header="Transaction yaşı" Binding="{Binding TxAge}"/>
                                <DataGridTextColumn Header="Bekleyen" Binding="{Binding Blocked}"/>
                                <DataGridTextColumn Header="Derinlik" Binding="{Binding Depth}"/>
                                <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Lock bekleyen session'lar (en eskisi üstte)"/>
                        <TextBox DockPanel.Dock="Bottom" Height="44" Style="{StaticResource SqlBox}" Text="{Binding SelectedWaiter.FullSql, Mode=OneWay}"/>
                        <DataGrid ItemsSource="{Binding Waiters}" SelectedItem="{Binding SelectedWaiter}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}"/>
                                <DataGridTextColumn Header="Veritabanı" Binding="{Binding Database}"/>
                                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}"/>
                                <DataGridTextColumn Header="Bekleme" Binding="{Binding Wait}"/>
                                <DataGridTextColumn Header="Bekleme süresi" Binding="{Binding QueryAge}"/>
                                <DataGridTextColumn Header="Bloklayan" Binding="{Binding BlockedBy}"/>
                                <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Veritabanları"/>
                            <DataGrid ItemsSource="{Binding Databases}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Veritabanı" Binding="{Binding Database}" Width="*"/>
                                    <DataGridTextColumn Header="Session" Binding="{Binding Sessions}"/>
                                    <DataGridTextColumn Header="Aktif" Binding="{Binding Active}"/>
                                    <DataGridTextColumn Header="Idle in tx" Binding="{Binding IdleInTransaction}"/>
                                    <DataGridTextColumn Header="Lock bekleyen" Binding="{Binding LockWaiting}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Column="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Son olaylar"/>
                            <DataGrid ItemsSource="{Binding Events}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zaman" Binding="{Binding Time}"/>
                                    <DataGridTextColumn Header="Olay" Binding="{Binding Incident}"/>
                                    <DataGridTextColumn Header="Ne oldu" Binding="{Binding Kind}"/>
                                    <DataGridTextColumn Header="Önem" Binding="{Binding Severity}"/>
                                    <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>

                    <StackPanel Grid.Row="6" Margin="0,8,0,0">
                        <TextBlock Foreground="{StaticResource Muted}"><Run Text="Depolama: "/><Run Text="{Binding Storage, Mode=OneWay}"/></TextBlock>
                        <TextBlock Foreground="{StaticResource Muted}"><Run Text="Mail: "/><Run Text="{Binding Mail, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ INCIDENTS -->
            <TabItem Header="  Olaylar  " DataContext="{Binding Incidents}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="5*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Content="Yenile" Command="{Binding RefreshCommand}" Margin="0"/>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="Kayıtlı olaylar"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding Incidents}" SelectedItem="{Binding SelectedIncident}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Id}"/>
                                <DataGridTextColumn Header="Başlangıç" Binding="{Binding Opened}"/>
                                <DataGridTextColumn Header="Süre" Binding="{Binding Duration}"/>
                                <DataGridTextColumn Header="Durum" Binding="{Binding Status}"/>
                                <DataGridTextColumn Header="Önem" Binding="{Binding Severity}"/>
                                <DataGridTextColumn Header="Veritabanları" Binding="{Binding Databases}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.2*"/>
                            <RowDefinition Height="1.4*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1.2*"/>
                            <RowDefinition Height="2*"/>
                            <RowDefinition Height="70"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding DetailHeader}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <DockPanel Grid.Row="1">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Zaman çizelgesi"/>
                            <DataGrid ItemsSource="{Binding Events}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zaman" Binding="{Binding Time}"/>
                                    <DataGridTextColumn Header="Ne oldu" Binding="{Binding Kind}"/>
                                    <DataGridTextColumn Header="Önem" Binding="{Binding Severity}"/>
                                    <DataGridTextColumn Header="Ayrıntı" Binding="{Binding Detail}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="Örnekler (en kötü an seçili gelir)"/>
                            <DataGrid ItemsSource="{Binding Samples}" SelectedItem="{Binding SelectedSample}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Zaman" Binding="{Binding Time}"/>
                                    <DataGridTextColumn Header="Aşama" Binding="{Binding Phase}"/>
                                    <DataGridTextColumn Header="Özet" Binding="{Binding Summary}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <TextBlock Grid.Row="3" Text="{Binding SampleHeader}" Margin="0,10,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <DockPanel Grid.Row="4">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="O andaki kök bloklayıcılar (şüpheli)"/>
                            <DataGrid ItemsSource="{Binding Blockers}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}"/>
                                    <DataGridTextColumn Header="Veritabanı" Binding="{Binding Database}"/>
                                    <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}"/>
                                    <DataGridTextColumn Header="İstemci" Binding="{Binding Client}"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding State}"/>
                                    <DataGridTextColumn Header="Tx yaşı" Binding="{Binding TxAge}"/>
                                    <DataGridTextColumn Header="Bekleyen" Binding="{Binding Blocked}"/>
                                    <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <DockPanel Grid.Row="5">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource H2}" Text="O andaki session'lar (boştaki session'lar kaydedilmez)"/>
                            <DataGrid ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}"/>
                                    <DataGridTextColumn Header="Veritabanı" Binding="{Binding Database}"/>
                                    <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}"/>
                                    <DataGridTextColumn Header="İstemci" Binding="{Binding Client}"/>
                                    <DataGridTextColumn Header="Durum" Binding="{Binding State}"/>
                                    <DataGridTextColumn Header="Bekleme" Binding="{Binding Wait}"/>
                                    <DataGridTextColumn Header="Tx yaşı" Binding="{Binding TxAge}"/>
                                    <DataGridTextColumn Header="Sorgu yaşı" Binding="{Binding QueryAge}"/>
                                    <DataGridTextColumn Header="Bloklayan" Binding="{Binding BlockedBy}"/>
                                    <DataGridTextColumn Header="SQL" Binding="{Binding Sql}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                        <TextBox Grid.Row="6" Style="{StaticResource SqlBox}" Text="{Binding SqlText, Mode=OneWay}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================================================ SETTINGS -->
            <TabItem Header="  Ayarlar  " DataContext="{Binding Settings}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="12" MaxWidth="1100" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="520"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*" MinWidth="360"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="Veri kaynağı"/>
                            <RadioButton Content="Demo (kurgusal veri, ağ bağlantısı yok)" IsChecked="{Binding IsDemo}" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Margin="20,0,0,6">
                                <TextBlock Text="Senaryo:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="80" ItemsSource="{Binding ScenarioIds}" SelectedItem="{Binding DemoScenario}"/>
                            </StackPanel>
                            <RadioButton Content="Canlı – gerçek PostgreSQL (salt okunur)" IsChecked="{Binding IsLive}" Margin="0,0,0,4"/>

                            <TextBlock Style="{StaticResource H2}" Text="PostgreSQL bağlantısı"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Sunucu" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PgHost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding PgPort}"/>
                                <TextBlock Grid.Row="2" Text="Veritabanı" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PgDatabase}"/>
                                <TextBlock Grid.Row="3" Text="Kullanıcı" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PgUser, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Text="SSL" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6" ItemsSource="{Binding SslModes}" SelectedItem="{Binding PgSsl}"/>
                                <TextBlock Grid.Row="5" Text="Şifre" VerticalAlignment="Center"/><PasswordBox x:Name="PgPassword" Grid.Row="5" Grid.Column="1"/>
                            </Grid>
                            <TextBlock Text="{Binding PgPasswordState}" Foreground="{StaticResource Muted}" Margin="130,0,0,6"/>
                            <WrapPanel Margin="130,0,0,0">
                                <Button Content="Şifreyi kaydet" Click="SavePgPassword_Click" ToolTip="Windows Credential Manager'a kaydeder"/>
                                <Button Content="Sadece bu oturum" Click="SessionPgPassword_Click" ToolTip="Kaydetmez; uygulama kapanınca unutulur"/>
                                <Button Content="Şifreyi sil" Click="DeletePgPassword_Click"/>
                            </WrapPanel>
                            <Button Content="Bağlantıyı test et" Click="TestConnection_Click" Margin="130,8,0,0" HorizontalAlignment="Left"/>
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="130,6,0,0"
                                       Text="Bağlantı her zaman default_transaction_read_only=on ile açılır; sunucu bunu onaylamazsa izleme başlamaz. pg_stat_activity'de 'PgMonitor (read-only)' olarak görünür."/>

                            <TextBlock Style="{StaticResource H2}" Text="E-posta"/>
                            <CheckBox Content="Olaylarda e-posta gönder" IsChecked="{Binding MailEnabled}" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="SMTP sunucu" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding SmtpHost, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding SmtpPort}"/>
                                <TextBlock Grid.Row="2" Text="Güvenlik" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" Width="140" HorizontalAlignment="Left" Margin="0,0,0,6" ItemsSource="{Binding SmtpSecurities}" SelectedItem="{Binding SmtpSecurity}"/>
                                <TextBlock Grid.Row="3" Text="Kullanıcı (ops.)" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SmtpUser, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Row="4" Text="Şifre" VerticalAlignment="Center"/><PasswordBox x:Name="SmtpPassword" Grid.Row="4" Grid.Column="1"/>
                                <TextBlock Grid.Row="5" Text="Gönderen" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding MailFrom}"/>
                                <TextBlock Grid.Row="6" Text="Alıcılar" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding MailTo}" ToolTip="Birden fazla adresi ; ile ayırın"/>
                                <TextBlock Grid.Row="7" Text="Mailde SQL (karakter)" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding SqlMaxChars}" ToolTip="0 = mailde SQL yok"/>
                            </Grid>
                            <TextBlock Text="{Binding SmtpPasswordState}" Foreground="{StaticResource Muted}" Margin="130,0,0,6"/>
                            <CheckBox Content="Önem arttığında da gönder (en fazla 10 dk'da bir)" IsChecked="{Binding SendOnEscalation}" Margin="130,0,0,6"/>
                            <WrapPanel Margin="130,0,0,0">
                                <Button Content="Şifreyi kaydet" Click="SaveSmtpPassword_Click"/>
                                <Button Content="Sadece bu oturum" Click="SessionSmtpPassword_Click"/>
                                <Button Content="Şifreyi sil" Click="DeleteSmtpPassword_Click"/>
                                <Button Content="Test maili gönder" Click="TestMail_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource H2}" Margin="0,0,0,6" Text="Örnekleme (canlı mod)"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Normal aralık (sn, en az 5)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding NormalInterval}"/>
                                <TextBlock Grid.Row="1" Text="Olay sırasında aralık (sn, en az 2)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding IncidentInterval}"/>
                            </Grid>
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Her örnek 2 hafif okuma sorgusudur; tek bağlantı kullanılır. pg_blocking_pids yalnızca en uzun bekleyen 50 session için çağrılır. Hatalı şifre veya yetki hatasında tekrar denenmez."/>

                            <TextBlock Style="{StaticResource H2}" Text="Eşikler"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="Lock bekleme eşiği (sn)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding LockWaitSeconds}"/>
                                <TextBlock Grid.Row="1" Text="Yüksek: bekleyen sayısı ≥" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding HighWaiters}"/>
                                <TextBlock Grid.Row="2" Text="Kritik: bekleyen sayısı ≥" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding CriticalWaiters}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource H2}" Text="Veritabanı → uygulama adı"/>
                            <TextBox Text="{Binding DatabaseApps}" AcceptsReturn="True" Height="110" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                     ToolTip="Her satıra bir eşleşme: veritabani_adi=Uygulama Adı"/>
                            <TextBlock Foreground="{StaticResource Muted}" Text="Her satır: veritabani_adi=Uygulama Adı"/>

                            <TextBlock Style="{StaticResource H2}" Text="Depolama"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Text="En fazla boyut (MB)" VerticalAlignment="Center"/><TextBox Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding MaxStorageMb}"/>
                                <TextBlock Grid.Row="1" Text="Kapanan olayları sakla (gün)" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Text="{Binding IncidentRetentionDays}"/>
                            </Grid>

                            <TextBlock Style="{StaticResource H2}" Text="Laptop"/>
                            <CheckBox Content="Prizdeyken bilgisayarı uyutma (sadece uygulama açıkken)" IsChecked="{Binding KeepAwake}"/>
                            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Text="Kapak kapanırsa yine uyur. Uyku ve VPN kesintileri kaydedilir ve hiçbir zaman 'düzeldi' sayılmaz."/>

                            <Button Content="Kaydet ve uygula" Command="{Binding DataContext.SaveAndApplyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,18,0,0" HorizontalAlignment="Left" FontWeight="SemiBold" Padding="18,6"/>
                            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,12,0,0">
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MinHeight="40"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
